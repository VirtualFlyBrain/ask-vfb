{
  "mcpServers": {
    "virtual-fly-brain": {
		"type" : "http",
     	"url": "https://vfb3-mcp-preview.virtualflybrain.org",
	 	"tools": ["*"]
	},
	 "artl-mcp": {
      "command": "uvx",
      "args": ["artl-mcp"],
      "tools": ["*"]
    },
    "ols4": {
      "type": "http",
      "url": "https://www.ebi.ac.uk/ols4/api/mcp",
      "tools": ["*"]
    },
      "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
     "tools": ["*"]
    },
    "Asta_semanticscholar": {
      "type": "http",
      "url": "https://asta-tools.allen.ai/mcp/v1",
      "headers": { "x-api-key": "${ASTA_API_KEY}"},
      "tools": ["*"]
    }
  }
}

